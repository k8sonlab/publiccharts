{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "nolte/mosquitto-exporter",
        "jacobalberty/unifi"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/k8sonlab/zwave-js-prom-exporter"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "matchDatasources": [
        "helmv3"
      ],
      "rangeStrategy": "bump",
      "automerge": true
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "automerge": true
    },
    {
      "matchPackageNames": ["eclipse-mosquitto"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?<compatibility>-(?:alpine|slim|debian|ubuntu).*)$"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Chart\\.yaml$/",
        "/(^|/)values\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>[^\\s]+)\\s+appVersion:\\s+[\"']?(?<currentValue>[^\"'\\s]+)[\"']?",
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\sappVersion: (?<currentValue>.*?)",
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s.*?appVersion: (?<currentValue>.*?)",
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s.*?tag: (?<currentValue>.*?)"
      ],
      "datasourceTemplate": "{{datasource}}",
      "depNameTemplate": "{{depName}}"
    }
  ]
}
